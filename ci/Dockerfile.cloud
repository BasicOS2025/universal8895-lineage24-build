FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    bc bison build-essential ccache curl flex libc6-dev-i386 lib32stdc++-11-dev \
    git git-lfs gnupg gperf imagemagick lib32readline-dev lib32z1-dev libelf-dev \
    liblz4-tool libssl-dev libxml2 libxml2-utils lzop pngcrush python3 rsync \
    schedtool squashfs-tools xsltproc zip unzip zlib1g-dev gcc-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu device-tree-compiler libfdt-dev ca-certificates \
    fontconfig libncurses5 libncursesw5 locales tzdata && \
    locale-gen en_US.UTF-8 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL --retry 3 https://storage.googleapis.com/git-repo-downloads/repo -o /usr/local/bin/repo && chmod 755 /usr/local/bin/repo
RUN useradd -m -u 1000 builder
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
USER builder
WORKDIR /workspace
